        Python
        
        ```
        from z3 import Solver, Real, Int, Bool, Implies, And, Not, unsat
        import time
        
        def verify_healthcare(state_pre: dict, state_post: dict) -> dict:
            t0 = time.perf_counter_ns()
            s = Solver()
            s.set("timeout", 50) # 50ms hard real-time ceiling
        
            egfr = Real("patient_egfr")
            metformin_dose = Int("metformin_dose")
            claim_submitted = Bool("claim_submitted")
            therapy_weeks = Int("therapy_weeks")
        
            # Bind actual shadow state values
            s.add(egfr == state_post["patient_egfr_ml_min"])
            s.add(metformin_dose == (state_post["prescribed_dose_mg"] if state_post["prescribed_drug"] == "Metformin" else 0))
            s.add(claim_submitted == state_post["claim_submitted"])
            s.add(therapy_weeks == state_post["conservative_therapy_weeks"])
        
            # Tracked formal invariants
            s.assert_and_track(Implies(egfr < 30.0, metformin_dose == 0), "INV_MED_01_RENAL_SAFETY")
            s.assert_and_track(Implies(claim_submitted, therapy_weeks >= 6), "INV_MED_02_PAYER_AUTH")
        
            result = s.check()
            latency_ms = (time.perf_counter_ns() - t0) / 1_000_000.0
            if result == unsat:
                failed_rules = [str(c) for c in s.unsat_core()]
                return {"status": "UNSAT", "proof_latency_ms": round(latency_ms, 3), "failed_rules": failed_rules}
            return {"status": "SAT", "proof_latency_ms": round(latency_ms, 3), "failed_rules": []}
