# Copy to deploy/production/.env and replace every value.
POSTGRES_ADMIN_USER=chronos_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
POSTGRES_APP_PASSWORD=replace-with-a-long-random-application-password
CHRONOS_API_TOKEN=replace-with-a-long-random-api-token-at-least-32-characters
PUBLIC_HOSTNAME=chronos.example.com
PUBLIC_ORIGIN=https://chronos.example.com
# Operator sign-in at the gateway. Generate the hash with:
#   docker run --rm caddy:2.9-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes so Compose does not expand the $ signs in the hash.
CHRONOS_UI_USER=operator
CHRONOS_UI_PASSWORD_HASH='replace-with-a-bcrypt-hash'
