{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronos-zero/contracts/z3_verdict.schema.json",
  "title": "Contract 3: Z3 Prover Verdict Payload",
  "type": "object",
  "required": ["trace_id", "shadow_branch_id", "status", "proof_latency_ms", "violated_invariants", "smt2_dump", "sha256_proof_hash"],
  "additionalProperties": false,
  "properties": {
    "trace_id": { "type": "string" },
    "shadow_branch_id": { "type": "string" },
    "status": { "enum": ["SAT", "UNSAT"] },
    "proof_latency_ms": { "type": "number", "minimum": 0 },
    "violated_invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "formal_assertion", "counterexample", "remediation_hint"],
        "additionalProperties": false,
        "properties": {
          "rule_id": { "type": "string", "pattern": "^INV_[A-Z]+_[0-9]{2}_[A-Z0-9_]+$" },
          "formal_assertion": { "type": "string" },
          "counterexample": { "type": "string" },
          "remediation_hint": { "type": "string" }
        }
      }
    },
    "smt2_dump": { "type": "string" },
    "sha256_proof_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
