# PostgreSQL server for all cartridge databases (local demo credentials from docker-compose.yml).
# Each service appends /chronos_<cartridge_id lowercased>.
CHRONOS_PG_DSN=postgresql://chronos_kernel:chronos_kernel@127.0.0.1:5432

# Durable audit chain database (separate volume-backed server, see docker-compose.yml audit-db).
CHRONOS_AUDIT_DSN=postgresql://chronos_kernel:chronos_kernel@127.0.0.1:5433/chronos_audit
